  m_Script: {fileID: 11500000, guid: 3a0a2b7d84bb4e46a35db5253d11c4a7, type: 3}
  m_Name: Torch
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  displayName: Daedalus
  lines:
  - Torches burn brighter when the bull-son is near.
  - Mind the light, have no fear.
  - The goal draws close, prepare for battle;
  - All will end once you slay the cattle.
